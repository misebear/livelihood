<% content_for(:title) { "Rush Pass Party 개인정보처리방침" } %>
<% content_for :head do %>
  <meta name="description" content="Rush Pass Party Android 앱의 연령대, 로컬 파티 세션, AdMob 광고, 동의 선택과 데이터 삭제를 설명합니다.">
  <link rel="canonical" href="<%= rush_pass_privacy_url %>">
