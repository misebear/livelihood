<% content_for(:title) { "Android 앱 36개 기능·지원·설치 | 보듬 앱 디렉터리" } %>
<% content_for(:description) { "JejuBucketList에서 운영하는 프로덕션 Android 앱 36개의 기능, 지원, 개인정보 안내와 Google Play 설치 링크를 확인합니다." } %>
<% content_for(:canonical_url) { app_support_url } %>
<% content_for(:page_h1_present) { "true" } %>
<% content_for :head do %>
  <link rel="alternate" type="application/rss+xml" title="보듬 Android 앱 업데이트" href="<%= play_apps_feed_url %>">
  <script type="application/ld+json"><%= json_escape({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "보듬 Android 앱 디렉터리",
    description: "JejuBucketList 프로덕션 Android 앱의 기능, 지원과 설치 안내",
    url: app_support_url,
    inLanguage: "ko-KR",
    hasPart: @apps.map { |app| { "@type": "SoftwareApplication", name: app[:name], url: play_app_url(app[:slug]), operatingSystem: "Android" } }
  }.to_json).html_safe %></script>
<% end %>

<section class="support-hero">
  <p class="support-eyebrow">JejuBucketList Android Apps</p>
  <h1>앱 기능·지원·설치 디렉터리</h1>
  <p>
    Play Console에서 프로덕션 상태를 확인한 Android 앱 36개의 기능, 대상 사용자, 지원 안내와 설치 링크를 모았습니다.
    임시·거부·삭제 앱은 설치 SEO에서 제외하고 아래 상태 목록으로 분리합니다.
  </p>
  <div class="support-actions">
    <a href="mailto:db0192a@gmail.com">이메일 문의</a>
    <a href="/privacy.html">개인정보 처리방침</a>
    <a href="/delete-account.html">데이터 삭제 요청</a>
    <a href="<%= play_apps_feed_path %>">최신 앱 RSS</a>
    <a href="/app-ads.txt">app-ads.txt</a>
  </div>
</section>

<section class="support-section" id="apps">
  <p class="support-eyebrow">Production Apps</p>
  <h3>프로덕션 앱 <%= @apps.length %>개</h3>
  <div class="support-grid">
    <% @apps.each do |app| %>
      <article id="<%= app[:slug] %>" class="support-card">
        <span class="support-chip"><%= app[:package_name] %></span>
        <h4><%= app[:name] %></h4>
        <p><%= app[:summary] %></p>
        <div class="support-card-links">
          <%= link_to "기능·지원", play_app_path(app[:slug]) %>
          <a href="<%= PlayAppCatalog.play_url(app, campaign: "directory-#{app[:slug]}") %>"
             data-analytics-event="download_click"
             data-analytics-category="play_store"
             data-analytics-label="directory-<%= app[:slug] %>"
             rel="noopener">Play 설치</a>
          <% if app[:support_path].present? %>
            <a href="<%= app[:support_path] %>">지원 페이지</a>
          <% end %>
          <% if app[:privacy_path].present? %>
            <a href="<%= app[:privacy_path] %>">개인정보처리방침</a>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>
</section>

<section class="support-section" id="held-apps">
  <p class="support-eyebrow">Hold / Recovery</p>
  <h3>임시·거부·삭제 앱 <%= @held_apps.length %>개</h3>
  <p>아래 앱은 공개 설치 페이지를 만들지 않습니다. Play 상태가 프로덕션으로 복구된 뒤 디렉터리에 추가합니다.</p>
  <div class="support-grid">
    <% @held_apps.each do |app| %>
      <% held_slug = {
        "com.issueon.app" => "batang-issue",
        "com.bodeum.party.secretsignal" => "secret-signal",
        "com.bodeum.party.taparena4" => "tap-arena-4"
      }.fetch(app[:package_name], app[:package_name].tr(".", "-")) %>
      <article id="<%= held_slug %>" class="support-card">
        <span class="support-status"><%= app[:status] %></span>
        <h4><%= app[:name] %></h4>
        <p class="support-chip"><%= app[:package_name] %></p>
        <div class="support-card-links">
          <% if app[:package_name] == "com.issueon.app" %>
            <%= link_to "지원 페이지", batang_issue_support_path %>
            <%= link_to "개인정보처리방침", batang_issue_privacy_path %>
          <% elsif app[:package_name] == "com.bodeum.party.secretsignal" %>
            <%= link_to "지원 페이지", secret_signal_support_path %>
            <%= link_to "개인정보처리방침", secret_signal_privacy_path %>
          <% elsif app[:package_name] == "com.bodeum.party.taparena4" %>
            <%= link_to "지원 페이지", tap_arena_support_path %>
            <%= link_to "개인정보처리방침", tap_arena_privacy_path %>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>
</section>

<section class="support-section">
  <p class="support-eyebrow">Support Contract</p>
  <h3>문의할 때 같이 보내주세요</h3>
  <p>앱 이름, 패키지명, 기기 모델, Android 버전, 앱 버전과 문제 화면을 함께 보내면 더 빠르게 확인할 수 있습니다.</p>
</section>

<%= render "directory_styles" %>
